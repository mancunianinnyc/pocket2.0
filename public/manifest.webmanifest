{
  "name": "Personal Library",
  "short_name": "Library",
  "description": "Save anything quickly and recover the useful idea later.",
  "start_url": "/library",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f0e1",
  "theme_color": "#f5f0e1",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Save a link",
      "short_name": "Save",
      "url": "/save"
    },
    {
      "name": "Ask my library",
      "short_name": "Ask",
      "url": "/ask"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
