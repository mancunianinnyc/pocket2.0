{
  "name": "Personal Library",
  "short_name": "Library",
  "description": "Save anything quickly and recover the useful idea later.",
  "start_url": "/library",
  "display": "standalone",
  "background_color": "#f7f5ef",
  "theme_color": "#42614f",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
