# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# personal import manifests (names, email quotes, saved tweets)
/scripts/data/

# local pnpm cache used by sandboxed development
.pnpm-cache/
.pnpm-store/
.pnpm-state/

# typescript
*.tsbuildinfo
next-env.d.ts
